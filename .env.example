# Configuración de cliente OmniRoute para Meta Agent Evolution
# Las credenciales reales residen exclusivamente en el entorno local. No incluir secretos ni claves reales.

# URL base del endpoint local de OmniRoute (solo http://127.0.0.1, localhost o [::1])
OMNIROUTE_BASE_URL=http://127.0.0.1:20129/v1

# Modelo registrado en OmniRoute
OMNIROUTE_MODEL=baseten/meta-models/muse-spark-open-1026

# Clave de API leída desde process.env (mantener vacía en el archivo de plantilla; configurar solo en entorno)
OMNIROUTE_API_KEY=

# Límites operativos del adaptador (definidos en src/meta-adapter.mjs)
OMNIROUTE_MAX_REQUESTS=1
OMNIROUTE_MAX_OUTPUT_TOKENS=512
OMNIROUTE_MAX_INPUT_CHARACTERS=16000
OMNIROUTE_MAX_RESPONSE_BYTES=256000

# Presupuesto y tarificación opcionales (deshabilitados por defecto)
# OMNIROUTE_MAX_COST=0.00
# OMNIROUTE_INPUT_COST_PER_MILLION=0.00
# OMNIROUTE_OUTPUT_COST_PER_MILLION=0.00
